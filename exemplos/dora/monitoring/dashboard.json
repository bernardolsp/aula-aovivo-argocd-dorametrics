      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name, phase) (argocd_app_sync_total{project=\"dora-lab\",name=\"loja-prod\",dry_run=\"false\",phase=~\"Failed|Error\"})",
          "instant": false,
          "legendFormat": "{{name}} {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem observações",
