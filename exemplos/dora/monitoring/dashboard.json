{
  "uid": "argocd-dora-lab",
  "title": "Argo CD e DORA — LinuxTips",
  "tags": [
    "argocd",
    "dora",
    "linuxtips"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Métricas REAIS do Argo CD",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Operação do reconciliador. Um sync Succeeded pode ser re-sync ou correção de drift. Reconciliação não mede commit → produção. Esses painéis não são, por si só, DORA."
      }
    },
    {
      "id": 2,
      "title": "Syncs Succeeded — contador do controller",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(argocd_app_sync_total{project=\"dora-lab\",name=\"loja-prod\",phase=\"Succeeded\",dry_run=\"false\"})",
          "instant": true,
          "legendFormat": "{{name}}{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem observações",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Falhas de sync / tentativas (5m)",
      "type": "stat",
      "description": "Nenhuma tentativa = sem observações. Não é Change fail rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(lab:argocd_sync_failure_ratio:5m)",
          "instant": true,
          "legendFormat": "{{name}}{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Sem observações",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Reconciliação p95 (5m)",
      "type": "stat",
      "description": "Duração do reconciliador. Não é lead time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(lab:argocd_reconcile_p95_seconds:5m)",
          "instant": true,
          "legendFormat": "{{name}}{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem observações",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Argo considera loja-prod Healthy?",
      "type": "stat",
      "description": "1 = Healthy. Observe que a versão broken ainda responde HTTP 503.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(argocd_app_info{project=\"dora-lab\",name=\"loja-prod\",health_status=\"Healthy\"} == 1) or vector(0)",
          "instant": true,
          "legendFormat": "{{name}}{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem observações",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Syncs Succeeded (5m, estimativa)",
      "type": "timeseries",
      "description": "increase extrapola; pode ser fracionário. Não mede contagem exata de entregas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab:argocd_syncs_succeeded:5m",
          "instant": false,
          "legendFormat": "{{name}}{{service}}"
